# PlatformIO build caches and generated IDE files
**/.pio/
**/.pioenvs/
**/.piolibdeps/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# Local configuration. Copy each *_example.h template, then fill it in.
# The filled-in headers stay untracked.
**/wifi_secrets.h
**/gemini_config.h
**/camera_config.h
**/*_secrets.h
**/secrets.h
**/*config_secret*.h
**/.env
**/.env.*
**/secrets/
**/credentials/
**/*credentials*.json
**/*_secret.*
**/*_secrets.*
**/service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Templates are meant to be published.
!**/*_example.h
!**/.env.example
